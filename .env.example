# GeoVision Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8001

# Tool Execution Modes
# Set MOCK_RS_TOOLS=false to run deterministic remote-sensing calculations (rasterio, numpy, ndvi)
MOCK_RS_TOOLS=false

# Set MOCK_VLM=true to use simulated RS-InternVL responses, or false to call live Gemini/VLM
MOCK_VLM=true

# Optional: Real Gemini API Key (only required if MOCK_VLM=false)
# GEMINI_API_KEY=your_gemini_api_key_here
