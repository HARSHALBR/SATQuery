# SATQuery AI Environment Configuration

# Mock mode — set to true during development before real models are ready
MOCK_VLM=true
MOCK_RS_TOOLS=true

# Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO

# VLM endpoint (used when MOCK_VLM=false)
VLM_ENDPOINT=http://localhost:8001

# RS Tools endpoint (used when MOCK_RS_TOOLS=false)
RS_TOOLS_ENDPOINT=http://localhost:8002

# VLM Configuration
VLM_PROVIDER=mock
VLM_API_KEY=
